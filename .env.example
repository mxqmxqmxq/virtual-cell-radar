# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，绝不要提交进 git。
# 没有 key 时流水线仍可运行，LLM 打分步骤会被跳过并标记为未打分。
ANTHROPIC_API_KEY=

# 可选：覆盖默认路径（默认相对当前目录）
# AIVC_CONFIG_DIR=config
# AIVC_DATA_DIR=data
# AIVC_SITE_DIR=site

# 以下仅本机私有档使用，公开部署不需要：
# AIVC_LOCAL=1            # 等价于命令行 --local：叠加 local/ 下的私有课题与私有论文，输出写到 local/reports、local/site
# AIVC_LOCAL_DIR=local
# AIVC_SEED_DIR=          # 种子 PDF 目录；seed 命令导入的内容只写到 local/data，不进公开库

# 可选：GitHub 个人访问令牌，只用于 `aivc resources refresh` 读取公开仓库的 star、最近推送等指标。
# 留空则走匿名访问（限额 60 次/小时，超限会优雅停止并报告何时可重试）；有令牌为 5000 次/小时。
# 只读公开信息，不需要勾选任何权限（scope）。
GITHUB_TOKEN=
